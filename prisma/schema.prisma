generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  full_name  String?
  created_at DateTime @default(now())
  avatar_url String?
  password   String
  updated_at DateTime @updatedAt
  cars       Car[]

  @@map("users")
}

model Car {
  id              String          @id @default(uuid())
  user_id         String
  name            String
  model           String?
  year            Int
  color           String?
  licence_plate   String?
  mileage         Int?
  fuel_type       FuelType        @default(PETROL)
  image_url       String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  service_records ServiceRecord[]

  @@map("cars")
}

model ServiceRecord {
  id                 String    @id @default(uuid())
  car_id             String
  type               SRType
  service_date       DateTime
  next_service_date  DateTime?
  mileage_at_service Int?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  car                Car       @relation(fields: [car_id], references: [id], onDelete: Cascade)

  @@map("service_records")
}

enum FuelType {
  PETROL   @map("petrol")
  DIESEL   @map("diesel")
  HYBRID   @map("hybrid")
  ELECTRIC @map("electric")
}

enum SRType {
  OIL_CHANGE    @map("oil_change")
  SMALL_SERVICE @map("small_service")
  BIG_SERVICE   @map("big_service")
  TIRE_CHANGE   @map("tire_change")
  REGISTRATION  @map("registration")
}
